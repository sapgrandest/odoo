      "required": false,
      "selection": [
        [
          "not_tested",
          "Not Tested"
        ],
        [
          "valid",
          "Valid"
        ],
        [
          "invalid",
          "Invalid"
        ]
      ],
      "string": "Alias Status",
      "type": "selection"
    },
    "create_uid": {
      "readonly": true,
