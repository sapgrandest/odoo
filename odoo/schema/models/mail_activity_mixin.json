{
  "model": "mail.activity.mixin",
  "name": "Activity Mixin",
  "field_count": 14,
  "fields": {
    "id": {
      "readonly": true,
      "required": false,
      "string": "ID",
      "type": "integer"
    },
    "display_name": {
      "readonly": true,
      "required": false,
      "string": "Display Name",
      "type": "char"
    },
    "activity_ids": {
      "readonly": false,
      "relation": "mail.activity",
      "required": false,
      "string": "Activities",
      "type": "one2many"
    },
    "activity_state": {
      "help": "Status based on activities\nOverdue: Due date is already passed\nToday: Activity date is today\nPlanned: Future activities.",
      "readonly": true,
      "required": false,
      "selection": [
        [
          "overdue",
          "Overdue"
        ],
        [
          "today",
          "Today"
        ],
        [
          "planned",
          "Planned"
        ]
      ],
      "string": "Activity State",
      "type": "selection"
    },
    "activity_user_id": {
      "readonly": true,
      "relation": "res.users",
      "required": false,
      "string": "Responsible User",
      "type": "many2one"
    },
    "activity_type_id": {
      "readonly": false,
      "relation": "mail.activity.type",
      "required": false,
      "string": "Next Activity Type",
      "type": "many2one"
    },
    "activity_type_icon": {
      "help": "Font awesome icon e.g. fa-tasks",
      "readonly": true,
      "required": false,
      "string": "Activity Type Icon",
      "type": "char"
    },
    "activity_date_deadline": {
      "readonly": true,
      "required": false,
      "string": "Next Activity Deadline",
      "type": "date"
    },
    "my_activity_date_deadline": {
      "readonly": true,
      "required": false,
      "string": "My Activity Deadline",
      "type": "date"
    },
    "activity_summary": {
      "readonly": false,
      "required": false,
      "string": "Next Activity Summary",
      "type": "char"
    },
    "activity_exception_decoration": {
      "help": "Type of the exception activity on record.",
      "readonly": true,
      "required": false,
      "selection": [
        [
          "warning",
          "Alert"
        ],
        [
          "danger",
          "Error"
        ]
      ],
      "string": "Activity Exception Decoration",
      "type": "selection"
    },
    "activity_exception_icon": {
      "help": "Icon to indicate an exception activity.",
      "readonly": true,
      "required": false,
      "string": "Icon",
      "type": "char"
    },
    "activity_plans_ids": {
      "readonly": true,
      "relation": "mail.activity.plan",
      "required": false,
      "string": "Activity Plans",
      "type": "many2many"
    },
    "activity_calendar_event_id": {
      "readonly": true,
      "relation": "calendar.event",
      "required": false,
      "string": "Next Activity Calendar Event",
      "type": "many2one"
    }
  }
}