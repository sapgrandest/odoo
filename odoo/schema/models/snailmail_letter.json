      "type": "many2one"
    },
    "notification_ids": {
      "readonly": false,
      "relation": "mail.notification",
      "required": false,
      "string": "Notifications",
      "type": "one2many"
    },
    "street": {
      "readonly": false,
      "required": false,
      "string": "Street",
      "type": "char"
    },
    "street2": {
      "readonly": false,
      "required": false,
      "string": "Street2",
      "type": "char"
    },
    "zip": {
      "readonly": false,
      "required": false,
      "string": "Zip",
      "type": "char"
    },
    "city": {
      "readonly": false,
      "required": false,
      "string": "City",
      "type": "char"
    },
    "state_id": {
      "readonly": false,
