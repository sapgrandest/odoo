{
  "model": "snailmail.letter",
  "name": "Snailmail Letter",
  "field_count": 30,
  "fields": {
    "id": {
      "readonly": true,
      "required": false,
      "string": "ID",
      "type": "integer"
    },
    "display_name": {
      "readonly": true,
      "required": false,
      "string": "Display Name",
      "type": "char"
    },
    "user_id": {
      "readonly": false,
      "relation": "res.users",
      "required": false,
      "string": "Sent by",
      "type": "many2one"
    },
    "model": {
      "readonly": false,
      "required": true,
      "string": "Model",
      "type": "char"
    },
    "res_id": {
      "readonly": false,
      "required": true,
      "string": "Document ID",
      "type": "integer"
    },
    "partner_id": {
      "readonly": false,
      "relation": "res.partner",
      "required": true,
      "string": "Recipient",
      "type": "many2one"
    },
    "company_id": {
      "readonly": true,
      "relation": "res.company",
      "required": true,
      "string": "Company",
      "type": "many2one"
    },
    "report_template": {
      "readonly": false,
      "relation": "ir.actions.report",
