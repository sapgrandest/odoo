      "type": "many2one"
    },
    "attachment_raw": {
      "readonly": true,
      "required": false,
      "string": "Document",
      "type": "binary"
    },
    "attachment_fname": {
      "readonly": true,
      "required": false,
      "string": "Attachment Filename",
      "type": "char"
    },
    "color": {
      "readonly": false,
      "required": false,
      "string": "Color",
      "type": "boolean"
    },
    "cover": {
      "readonly": false,
      "required": false,
      "string": "Cover Page",
      "type": "boolean"
    },
    "duplex": {
      "readonly": false,
      "required": false,
      "string": "Both side",
      "type": "boolean"
    },
    "state": {
      "help": "When a letter is created, the status is 'Pending'.\nIf the letter is correctly sent, the status goes in 'Sent',\nIf not, it will got in state 'Error' and the error message will be displayed in the field 'Error Message'.",
      "readonly": true,
      "required": true,
      "selection": [
        [
          "pending",
          "In Queue"
        ],
        [
          "sent",
          "Sent"
        ],
        [
          "error",
          "Error"
        ],
        [
          "canceled",
          "Cancelled"
        ]
      ],
      "string": "Status",
      "type": "selection"
    },
    "error_code": {
      "readonly": false,
      "required": false,
      "selection": [
        [
          "MISSING_REQUIRED_FIELDS",
          "MISSING_REQUIRED_FIELDS"
        ],
        [
          "CREDIT_ERROR",
          "CREDIT_ERROR"
        ],
        [
          "TRIAL_ERROR",
          "TRIAL_ERROR"
        ],
        [
          "NO_PRICE_AVAILABLE",
          "NO_PRICE_AVAILABLE"
        ],
        [
          "FORMAT_ERROR",
          "FORMAT_ERROR"
        ],
        [
          "UNKNOWN_ERROR",
          "UNKNOWN_ERROR"
        ],
        [
          "ATTACHMENT_ERROR",
          "ATTACHMENT_ERROR"
        ]
      ],
      "string": "Error",
      "type": "selection"
    },
    "info_msg": {
      "readonly": false,
      "required": false,
      "string": "Information",
      "type": "html"
    },
    "reference": {
      "readonly": true,
      "required": false,
