    },
    "total_route_ids": {
      "readonly": true,
      "relation": "stock.route",
      "required": false,
      "string": "Total routes",
      "type": "many2many"
    },
    "putaway_rule_ids": {
      "readonly": false,
      "relation": "stock.putaway.rule",
      "required": false,
      "string": "Putaway Rules",
      "type": "one2many"
    },
    "packaging_reserve_method": {
      "help": "Reserve Only Full Packagings: will not reserve partial packagings. If customer orders 2 pallets of 1000 units each and you only have 1600 in stock, then only 1000 will be reserved\nReserve Partial Packagings: allow reserving partial packagings. If customer orders 2 pallets of 1000 units each and you only have 1600 in stock, then 1600 will be reserved",
      "readonly": false,
      "required": false,
      "selection": [
        [
          "full",
          "Reserve Only Full Packagings"
        ],
        [
          "partial",
          "Reserve Partial Packagings"
        ]
      ],
      "string": "Reserve Packagings",
      "type": "selection"
    },
    "filter_for_stock_putaway_rule": {
      "readonly": false,
      "required": false,
      "string": "stock.putaway.rule",
      "type": "boolean"
    },
    "anglo_saxon_accounting": {
      "help": "If checked, the product will be valued using the Anglo-Saxon accounting method.",
      "readonly": true,
      "required": false,
      "string": "Use Anglo-Saxon Accounting",
      "type": "boolean"
    },
    "property_valuation": {
      "help": "Periodic: The accounting entries are suggested manually in the inventory valuation report.\n        Perpetual: An accounting entry is automatically created to value the inventory when a product is billed or invoiced.\n        ",
      "readonly": false,
      "required": false,
      "selection": [
        [
          "periodic",
          "Periodic (at closing)"
        ],
        [
          "real_time",
          "Perpetual (at invoicing)"
        ]
      ],
      "string": "Inventory Valuation",
      "type": "selection"
    },
    "property_cost_method": {
      "help": "Standard Price: The products are valued at their standard cost defined on the product.\n        Average Cost (AVCO): The products are valued at weighted average cost.\n        First In First Out (FIFO): The products are valued supposing those that enter the company first will also leave it first.\n        ",
      "readonly": false,
      "required": false,
      "selection": [
        [
          "standard",
          "Standard Price"
        ],
        [
          "fifo",
          "First In First Out (FIFO)"
        ],
        [
          "average",
          "Average Cost (AVCO)"
        ]
      ],
      "string": "Costing Method",
      "type": "selection"
    },
