{
  "model": "hr.contract.sign.document.wizard",
  "name": "Sign document in contract",
  "field_count": 21,
  "fields": {
    "id": {
      "readonly": true,
      "required": false,
      "string": "ID",
      "type": "integer"
    },
    "display_name": {
      "readonly": true,
      "required": false,
      "string": "Display Name",
      "type": "char"
    },
    "version_id": {
      "readonly": false,
      "relation": "hr.version",
      "required": false,
      "string": "Contract",
      "type": "many2one"
    },
    "employee_ids": {
      "readonly": false,
      "relation": "hr.employee",
      "required": false,
      "string": "Employees",
      "type": "many2many"
    },
    "responsible_id": {
      "readonly": false,
      "relation": "res.users",
      "required": false,
      "string": "Responsible",
      "type": "many2one"
    },
    "employee_role_id": {
