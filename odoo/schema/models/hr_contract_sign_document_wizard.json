      "string": "Attachment",
      "type": "many2many"
    },
    "mail_to": {
      "help": "Email used to send the signature request.\n                - Work takes the email defined in \"work email\"\n                - Private takes the email defined in Private Information\n                - If the selected email is not defined, the available one will be used.",
