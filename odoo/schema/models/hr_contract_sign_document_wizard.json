      "readonly": false,
      "required": false,
      "string": "Template Warning",
      "type": "char"
    },
    "subject": {
      "readonly": false,
      "required": true,
      "string": "Subject",
      "type": "char"
    },
    "message": {
      "readonly": false,
      "required": false,
      "string": "Message",
      "type": "html"
    },
    "cc_partner_ids": {
      "readonly": false,
