      "readonly": false,
      "relation": "res.partner",
      "required": false,
      "string": "Partner Address",
      "type": "many2one"
    },
    "propagate_cancel": {
      "help": "When ticked, if the move created by this rule is cancelled, the next move will be cancelled too.",
      "readonly": false,
      "required": false,
      "string": "Cancel Next Move",
      "type": "boolean"
    },
    "propagate_carrier": {
      "help": "When ticked, carrier of shipment will be propagated.",
      "readonly": false,
      "required": false,
      "string": "Propagation of carrier",
      "type": "boolean"
    },
    "warehouse_id": {
      "readonly": false,
      "relation": "stock.warehouse",
      "required": false,
      "string": "Warehouse",
      "type": "many2one"
    },
    "auto": {
      "help": "The 'Manual Operation' value will create a stock move after the current one. With 'Automatic No Step Added', the location is replaced in the original move.",
      "readonly": false,
      "required": true,
      "selection": [
        [
          "manual",
          "Manual Operation"
        ],
        [
          "transparent",
          "Automatic No Step Added"
        ]
      ],
      "string": "Automatic Move",
      "type": "selection"
    },
    "rule_message": {
      "readonly": true,
      "required": false,
      "string": "Rule Message",
      "type": "html"
    },
    "push_domain": {
      "readonly": false,
      "required": false,
      "string": "Push Applicability",
      "type": "char"
    },
    "create_uid": {
