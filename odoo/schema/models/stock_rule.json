{
  "model": "stock.rule",
  "name": "Stock Rule",
  "field_count": 28,
  "fields": {
    "id": {
      "readonly": true,
      "required": false,
      "string": "ID",
      "type": "integer"
    },
    "display_name": {
      "readonly": true,
      "required": false,
      "string": "Display Name",
      "type": "char"
    },
