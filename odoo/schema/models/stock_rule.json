      "required": false,
      "string": "Source Location",
      "type": "many2one"
    },
    "location_dest_from_rule": {
      "help": "When set to True the destination location of the stock.move will be the rule.Otherwise, it takes it from the picking type.",
      "readonly": false,
      "required": false,
      "string": "Destination location origin from rule",
      "type": "boolean"
    },
    "route_id": {
      "readonly": false,
      "relation": "stock.route",
      "required": true,
      "string": "Route",
      "type": "many2one"
    },
    "route_company_id": {
