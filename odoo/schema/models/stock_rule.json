      "required": false,
      "string": "Created by",
      "type": "many2one"
    },
    "create_date": {
      "readonly": true,
      "required": false,
      "string": "Created on",
      "type": "datetime"
    },
    "write_uid": {
      "readonly": true,
      "relation": "res.users",
      "required": false,
      "string": "Last Updated by",
      "type": "many2one"
    },
    "write_date": {
      "readonly": true,
      "required": false,
      "string": "Last Updated on",
      "type": "datetime"
    }
  }
}