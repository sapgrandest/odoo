      "readonly": false,
      "required": true,
      "string": "Name",
      "type": "char"
    },
    "active": {
      "help": "If unchecked, it will allow you to hide the rule without removing it.",
      "readonly": false,
      "required": false,
      "string": "Active",
      "type": "boolean"
    },
    "action": {
      "readonly": false,
      "required": true,
      "selection": [
        [
          "pull",
          "Pull From"
        ],
        [
          "push",
          "Push To"
        ],
        [
          "pull_push",
          "Pull & Push"
        ],
        [
          "buy",
          "Buy"
        ]
      ],
      "string": "Action",
      "type": "selection"
    },
    "sequence": {
      "readonly": false,
      "required": false,
      "string": "Sequence",
      "type": "integer"
    },
    "company_id": {
      "readonly": false,
      "relation": "res.company",
      "required": false,
      "string": "Company",
      "type": "many2one"
    },
    "location_dest_id": {
      "readonly": false,
      "relation": "stock.location",
      "required": true,
      "string": "Destination Location",
      "type": "many2one"
    },
    "location_src_id": {
      "readonly": false,
