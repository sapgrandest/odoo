{
  "model": "helpdesk.sla.status",
  "name": "Ticket SLA Status",
  "field_count": 14,
  "fields": {
    "id": {
      "readonly": true,
      "required": false,
      "string": "ID",
      "type": "integer"
    },
    "display_name": {
      "readonly": true,
      "required": false,
      "string": "Display Name",
      "type": "char"
    },
    "ticket_id": {
      "readonly": false,
      "relation": "helpdesk.ticket",
      "required": true,
      "string": "Ticket",
      "type": "many2one"
    },
    "sla_id": {
      "readonly": false,
      "relation": "helpdesk.sla",
      "required": true,
      "string": "Sla",
      "type": "many2one"
    },
    "sla_stage_id": {
      "help": "Minimum stage a ticket needs to reach in order to satisfy this SLA.",
      "readonly": true,
      "relation": "helpdesk.stage",
      "required": false,
      "string": "Target Stage",
      "type": "many2one"
    },
    "deadline": {
      "readonly": true,
      "required": false,
      "string": "Deadline",
      "type": "datetime"
    },
    "reached_datetime": {
      "help": "Datetime at which the SLA stage was reached for the first time",
      "readonly": false,
      "required": false,
      "string": "Reached Date",
      "type": "datetime"
    },
    "status": {
      "readonly": true,
      "required": false,
      "selection": [
        [
          "failed",
          "Failed"
        ],
        [
          "reached",
          "Reached"
        ],
        [
          "ongoing",
          "Ongoing"
        ]
      ],
      "string": "Status",
      "type": "selection"
    },
    "color": {
      "readonly": true,
      "required": false,
      "string": "Color Index",
      "type": "integer"
    },
    "exceeded_hours": {
      "help": "Working hours exceeded for reached SLAs compared with deadline. Positive number means the SLA was reached after the deadline.",
      "readonly": true,
      "required": false,
      "string": "Exceeded Working Hours",
      "type": "float"
    },
    "create_uid": {
      "readonly": true,
      "relation": "res.users",
      "required": false,
      "string": "Created by",
      "type": "many2one"
    },
    "create_date": {
      "readonly": true,
      "required": false,
      "string": "Created on",
      "type": "datetime"
    },
    "write_uid": {
      "readonly": true,
      "relation": "res.users",
      "required": false,
      "string": "Last Updated by",
      "type": "many2one"
    },
    "write_date": {
      "readonly": true,
      "required": false,
      "string": "Last Updated on",
      "type": "datetime"
    }
  }
}