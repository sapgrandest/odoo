# ==============================================================
# Moto-Profil / ProfiAuto — Requêtes READ-ONLY avec logging automatique
# Source : Auth_API_ProfiAuto_ENG.pdf + Dokumentacja WS MP.pdf v1.7.9
# ==============================================================
# INSTRUCTIONS :
#   1. Lancer HTTPyac DEPUIS le dossier motoprofil/tests/ (les logs y seront créés)
#      > cd motoprofil/tests
#      > httpyac run moto-profil-api.http --name AUTH-01
#   2. Chaque requête crée un fichier JSON dans motoprofil/tests/logs/
#      Nom : AAAA-MM-JJTHH-MM-SS_{NOM_REQUETE}.json
#
# ⚠️  LECTURE SEULE — Les méthodes d'écriture (ZamowTowary*, SubmitOrder,
#      InvoiceCommission) ont été SUPPRIMÉES de ce fichier.
# ⚠️  SOAP utilise HTTP POST même pour les lectures — c'est le protocole SOAP.
#      Toutes les requêtes ici sont non-mutantes (aucune modification de données).
# ⚠️  Logging via require('fs') — fonctionne en mode CLI Node.js (httpyac CLI).
#      En extension VS Code, le logging fichier peut être désactivé (sandboxing).
# ==============================================================

# --- Identifiants REST (login/mdp ProfiAutoID = portail eSerwis) ---
# ⚠️  Centralisés dans ../../CREDENTIALS.md (fichier privé). Renseigner ici pour exécuter.
@USERNAME         = "SAP GRAND EST"
@PASSWORD         = REMPLIR_DEPUIS_CREDENTIALS_MD

# --- Numéros partenaire SOAP (compte TEST fourni par l'IT, e-mail 10/06/2026) ---
@FIKS             = 15060
@MOTONET          = 0BHS

# --- Articles échantillons ---
@MOTONET_1        = ABS0215Q
@MOTONET_2        = FTROP570
@DELNR_1          = 0043
@ELN_1            = CCH865
@DELNR_2          = 0003
@ELN_2            = 03.2419-8150.3

# --- Valeurs de test ---
@SAMPLE_DATE      = 2024-01-15
@SAMPLE_INVOICE   = FA 2543/06/2018/K
@SAMPLE_FKZ_ID    = 1730141
@SAMPLE_LZ_ID     = 3020930
@SAMPLE_GUID      = 452E4B5D-B5FF-44a2-B733-EDE0DC28C77E
@SAMPLE_VERSION   = 1.0.0

# --- Endpoints REST ---
@OAUTH_URL        = https://id.profiauto.pl/connect/token
@REST_API         = https://api.profiauto.net

# --- Endpoints SOAP (domaines primaire / secours — màj email IT 02/06/2026) ---
# Anciennes IP obsolètes : 195.242.186.3 (primaire) / 195.242.186.16 (secours)
@SOAP_HOST        = https://ws1.moto-profil.pl
@SOAP_BACKUP      = https://ws2.moto-profil.pl
@WS_KLIENT        = {{SOAP_HOST}}/MotoBiznesWS/WSMotoKlient.asmx
@WS_KLIENT_TD     = {{SOAP_HOST}}/MotoBiznesWS/WSMotoKlientTD.asmx
@WS_OFERTA        = {{SOAP_HOST}}/MotoBiznesWS/WSMotoOferta.asmx

# --- Token REST (auto-injecté par AUTH-01) ---
@TOKEN            =


# ==============================================================
# SECTION 1 — AUTHENTIFICATION REST (OAuth 2.0 ROPC)
# ==============================================================

### AUTH-01 — Obtenir le token Bearer (7 jours)
# @name AUTH-01
POST {{OAUTH_URL}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&scope=motoprofil-api&username={{USERNAME}}&password={{PASSWORD}}

< {%
  // Injection du token pour les requêtes REST suivantes
  client.global.set("TOKEN", response.body.access_token);

  // === LOGGING ===
  const fs = require('fs'), path = require('path');
  try {
    const dir = path.join(process.cwd(), 'logs');
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    const ts = new Date().toISOString().replace(/[:.]/g, '-');
    const log = {
      timestamp: new Date().toISOString(),
      nom_requete: 'AUTH-01_GetToken',
      requete: {
        methode: request.method,
        url: request.url,
        headers: request.headers,
        corps: '[credentials masqués dans le log]'
      },
      reponse: {
        statut: response.status,
        statut_texte: response.statusText,
        headers: response.headers,
        corps: { token_type: response.body.token_type, expires_in: response.body.expires_in, access_token: '***masqué***' }
      }
    };
    fs.writeFileSync(path.join(dir, `${ts}_AUTH-01_GetToken.json`), JSON.stringify(log, null, 2), 'utf-8');
  } catch(e) { /* CLI Node.js uniquement */ }
%}


# ==============================================================
# SECTION 2 — REST API ProfiAuto (api.profiauto.net) — READ ONLY
# ==============================================================

### REST-01 — GetPriceAndQuantity REST — Prix et disponibilité par NrMotonet
# @name REST-01
POST {{REST_API}}/api/External/PriceAndQuantity/GetPriceAndQuantity
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "items": [
    "{{MOTONET_1}}",
    "{{MOTONET_2}}"
  ]
}

< {%
  const fs = require('fs'), path = require('path');
  try {
    const dir = path.join(process.cwd(), 'logs');
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    const ts = new Date().toISOString().replace(/[:.]/g, '-');
    const log = {
      timestamp: new Date().toISOString(),
      nom_requete: 'REST-01_GetPriceAndQuantity',
      requete: { methode: request.method, url: request.url, headers: request.headers, corps: request.body },
      reponse: { statut: response.status, statut_texte: response.statusText, headers: response.headers, corps: response.body }
    };
    fs.writeFileSync(path.join(dir, `${ts}_REST-01_GetPriceAndQuantity.json`), JSON.stringify(log, null, 2), 'utf-8');
  } catch(e) {}
%}


